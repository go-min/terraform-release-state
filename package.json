{
  "name": "terraform-release-state",
  "version": "0.1.0",
  "description": "GitHub Action for Terraform state storage using GitHub Release assets",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "ncc build src/main.ts --minify --source-map",
    "format": "prettier --write action.yml package.json src tests",
    "format:check": "prettier --check action.yml package.json src tests",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vercel/ncc": "^0.44.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.17.0"
}
